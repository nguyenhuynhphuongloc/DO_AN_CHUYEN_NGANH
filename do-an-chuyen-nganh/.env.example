# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@host/database
PAYLOAD_SECRET=generate_a_secure_random_string_here

# =============================================================================
# AI Chatbot Service (Groq) - Required for AI financial advisor chatbot
# Get your API key at: https://console.groq.com/keys
# =============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=2048
AI_CHATBOT_SERVICE_URL=http://localhost:8000

# =============================================================================
# AI Service URLs
# =============================================================================
AI_SERVICE_URL=http://localhost:8001

# =============================================================================
# Google AI (optional - for other features)
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# Hypereal API (optional)
# =============================================================================
HYPEREAL_API_KEY=your_hypereal_api_key_here
HYPEREAL_BASE_URL=https://api.hypereal.cloud/v1

# =============================================================================
# Receipt AI (Veryfi OCR + Groq category resolution)
# Get Veryfi credentials at: https://veryfi.com/
# Get Groq API key at: https://console.groq.com/keys
# =============================================================================
VERYFI_CLIENT_ID=your_veryfi_client_id
VERYFI_CLIENT_SECRET=your_veryfi_client_secret
VERYFI_USERNAME=your_veryfi_username
VERYFI_API_KEY=your_veryfi_api_key
VERYFI_BASE_URL=https://api.veryfi.com/api/
VERYFI_API_VERSION=v8
VERYFI_TIMEOUT_SECONDS=30
VERYFI_MAX_RETRIES=2
GROQ_CATEGORY_RESOLUTION_ENABLED=true
RECEIPT_PREPROCESS_ENABLED=true
