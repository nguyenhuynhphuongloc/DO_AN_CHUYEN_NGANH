# Copy this file to .env for local development.
# Never commit .env or any real API keys/secrets.

# =============================================================================
# App / Payload CMS
# =============================================================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
PAYLOAD_SECRET=
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/fintrack

# =============================================================================
# Internal service URLs
# Docker Compose uses service hostnames:
#   AI_SERVICE_URL=http://receipt-ai:8001
#   AI_CHATBOT_SERVICE_URL=http://ai-chatbot:8000
# Local non-Docker development usually uses localhost.
# =============================================================================
AI_SERVICE_URL=http://localhost:8001
AI_CHATBOT_SERVICE_URL=http://localhost:8000

# =============================================================================
# Groq LLM
# Required for advisor responses and optional OCR category resolution.
# Create a key in the Groq console, then paste it only into .env.
# =============================================================================
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=2048
GROQ_CATEGORY_RESOLUTION_ENABLED=true

# =============================================================================
# Veryfi OCR
# Required for receipt image OCR.
# Create credentials in Veryfi, then paste them only into .env.
# =============================================================================
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=
VERYFI_BASE_URL=https://api.veryfi.com/api/
VERYFI_API_VERSION=v8
VERYFI_TIMEOUT_SECONDS=30
VERYFI_MAX_RETRIES=2
RECEIPT_PREPROCESS_ENABLED=false

# =============================================================================
# Optional integrations
# Leave blank when unused.
# =============================================================================
GOOGLE_API_KEY=
HYPEREAL_API_KEY=
HYPEREAL_BASE_URL=https://api.hypereal.cloud/v1
