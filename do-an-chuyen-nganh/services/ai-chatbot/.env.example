# Copy this file to .env when running the chatbot service standalone.
# Never commit .env or real API keys.

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=2048

# Service URL used by the web app or other internal services.
AI_CHATBOT_SERVICE_URL=http://localhost:8000

# Optional embedding-based classification.
# Requires sentence-transformers dependencies when enabled.
AI_CHATBOT_ENABLE_EMBEDDINGS=0
