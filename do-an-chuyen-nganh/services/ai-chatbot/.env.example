# Groq API key for AI chatbot (gpt-oss-120b)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=2048

# AI Chatbot Service URL (for other services to connect)
AI_CHATBOT_SERVICE_URL=http://localhost:8000

# Enable embedding-based classification (optional, requires sentence-transformers)
# AI_CHATBOT_ENABLE_EMBEDDINGS=0
